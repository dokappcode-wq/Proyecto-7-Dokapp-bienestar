{
  "name": "dokapp-bienestar",
  "version": "0.1.0",
  "description": "Dokapp: Bienestar — red social de pequeñas acciones de bienestar",
  "private": true,
  "engines": { "node": ">=20" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "build:server": "tsc --noEmit && VITE_BACKEND=api vite build",
    "start": "node server/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dokappcode-wq/Proyecto-7-Dokapp-bienestar.git"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
